  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0422\u0438\u0442\u0440\u044B:\n\u0410\u0432\u0442\u043E\u0440 \u0438\u0434\u0435\u0438
    \u0421\u0442\u0430\u0441\n\n\u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A
    \u0438 \u0410\u043D\u0438\u043C\u0430\u0442\u043E\u0440 \u0421\u0442\u0430\u0441\n\n\u0410\u0440\u0442
    \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u0421\u0442\u0430\u0441\n\n\u0418\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u041F\u0440\u043E\u0434\u044E\u0441\u0441\u0435\u0440 \u0421\u0442\u0430\u0441\n\n\u041F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0449\u0438\u043A
    \u0421\u0442\u0430\u0441\n\n\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442
    \u0421\u0442\u0430\u0441\n\n\u0413\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440
    \u0421\u0442\u0430\u0441\n\n\u0422\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0449\u0438\u043A
    \u0421\u0442\u0430\u0441\n\n\u041C\u0430\u0440\u043A\u0435\u0442\u043E\u043B\u043E\u0433
    \u0421\u0442\u0430\u0441\n\n\u0414\u0440\u0443\u0433\u0438\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0421\u0442\u0430\u0441\n\n\u0417\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u044B\u0439
    \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A \u0433\u043E\u0434\u0430 \u0421\u0442\u0430\u0441\n\n\u0417\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u044B\u0439
    \u043E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A \u0438\u0433\u0440\n\n\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A
    \u0438\u0433\u0440\u044B \u0421\u0442\u0430\u0441\n\n\n\n\n\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
    \u043C\u043E\u0438\u043C \u0430\u043B\u044C\u0444\u0430/\u0431\u0435\u0442\u0430
    \u0442\u0435\u0441\u0442\u0435\u0440\u0430\u043C- \nDj Shole\n\u0410\u043D\u044F 
    \n\u0412\u0438\u043A\u0430  \n\u0421\u0435\u0440\u0435\u0436\u0430  \n\u041C\u0438\u0448\u0430 
    \n\u041D\u0430\u0441\u0442\u044F  \nDJ Piska \nDj DROCHILA \u0421\u0435\u0440\u0435\u0436\u0430-\u0441\u0435\u0440\u0435\u0436\u0435\u043D\u044C\u043A\u0430\n\u0417\u0430
    \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441
    \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0438 \u043F\u043E\u043C\u043E\u0449\u044C
    \u0432 \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u043E\u0448\u0438\u0431\u043E\u043A/\u043D\u0435\u0434\u043E\u0447\u0435\u0442\u043E\u0432/\u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C \n\u0418 \u0421\u0442\u0430\u0441\u0443
    \u0437\u0430 \u043F\u0440\u043E\u0434\u0435\u043B\u0430\u043D\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
    \u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430\n\n\u0412\u0441\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0435
    \u0441\u043F\u0430\u0441\u0438\u0431\u043E !!!!"
